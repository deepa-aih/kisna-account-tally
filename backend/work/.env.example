# Local frontend URL(s), comma separated. Do not use * when cookie auth is enabled.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
CLIENT_NAME=Kisna

# Local development uses HTTP. Set true when the app is served over HTTPS.
COOKIE_SECURE=false

# MongoDB connection (local development). For Atlas, use the provider URI and
# keep credentials out of source control.
MONGODB_URI=mongodb://<credentials>@172.31.4.220:27017/account_tally?authSource=admin
MONGODB_DATABASE=account_tally

